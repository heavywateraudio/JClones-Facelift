function runtime_label_draw_literal(x, y, w, h, font_px, str, text_r, text_g, text_b, text_a)
  local(px, py, pw, ph, tw, th)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
