      runtime_text_font_private(runtime_sf(font_px));
      gfx_measurestr(str, tw, th);
      tw = runtime_text_draw_private(str, 1, 1);
      m = runtime_text_cap_ink_private(runtime_sf(font_px));
      gfx_x = px + floor((pw - tw) * 0.5);
      gfx_y = floor(py + ph * 0.5 - m);
      runtime_color_literal(tr, tg, tb, ta, tr, tg, tb, ta, 0, ps);
      runtime_text_draw_private(str, 0, 1);
    );
  );
  runtime_text_style(0, 0);
);

function runtime_knob_addr_private(widget_id)
(
  RUNTIME_ARENA_BASE + RUNTIME_WIDGET_OFF + (widget_id - 1) * 8;
);

function runtime_knob_decimals_private(vstep)
  local(d, i, s)
(
  vstep == 0 ? 2 : (
    d = 6;
    i = 6;
    loop(7,
      s = abs(vstep) * pow(10, i);
      abs(s - floor(s + 0.5)) <= 0.000000001 ? d = i;
      i -= 1;
    );
    d;
  );
);

function runtime_knob_init(widget_id, value, enabled, flags, vmin, vmax, vstep)
  local(a)
(
  a = runtime_knob_addr_private(widget_id);
  a[3] = vmin;
  a[4] = vmax;
  a[5] = vstep;
  a[6] = runtime_knob_decimals_private(vstep);
  a[0] = min(max(value, vmin), vmax);
  a[1] = enabled != 0 ? 1 : 0;
  a[2] = flags;
  a[7] = -1;
);

function runtime_knob_get(widget_id)
  local(a)
(
  a = runtime_knob_addr_private(widget_id);
  a[0];
);

function runtime_knob_set(widget_id, value)
  local(a)
(
  a = runtime_knob_addr_private(widget_id);
  a[0] = min(max(value, a[3]), a[4]);
);

function runtime_knob_format(widget_id, out)
  local(a, d, v)
(
  a = runtime_knob_addr_private(widget_id);
  d = a[6];
  v = a[0];
  floor(abs(v) * pow(10, d) + 0.5) == 0 ? v = 0;
  runtime_text_sign = v < 0 ? -1 : (v > 0 ? 1 : 0);
  d == 0 ? sprintf(out, "%.0f", v) :
  d == 1 ? sprintf(out, "%.1f", v) :
  d == 2 ? sprintf(out, "%.2f", v) :
  d == 3 ? sprintf(out, "%.3f", v) :
  d == 4 ? sprintf(out, "%.4f", v) :
  d == 5 ? sprintf(out, "%.5f", v) :
           sprintf(out, "%.6f", v);
  d;
);

function runtime_knob_format_text(widget_id, out, decimals, flags, unit, below)
  local(a, d, v, m, r, fmt)
(
  a = runtime_knob_addr_private(widget_id);
  v = a[0];
  d = decimals >= 0 ? decimals : a[6];
  runtime_text_sign = v < 0 ? -1 : (v > 0 ? 1 : 0);
  (v == a[3] && strlen(below) > 0) ? (
    strcpy(out, below);
  ) : (
    m = abs(v);
    ((flags & 2) && m >= 1000) ? (
      r = m >= 1000000 ? floor(m / 100000 + 0.5) : floor(m / 100 + 0.5);
      r = (v < 0 ? -r : r) / 10;
      fmt = (r == floor(r)) ? (((flags & 1) && r > 0) ? "%+.0f" : "%.0f")
                            : (((flags & 1) && r > 0) ? "%+.1f" : "%.1f");
      sprintf(out, fmt, r);
      strcat(out, m >= 1000000 ? "M" : "k");
    ) : (
      floor(m * pow(10, d) + 0.5) == 0 ? (v = 0; runtime_text_sign = 0;);
      fmt = ((flags & 1) && v > 0) ? (
        d == 0 ? "%+.0f" : (d == 1 ? "%+.1f" : (d == 2 ? "%+.2f" : (d == 3 ? "%+.3f" :
        (d == 4 ? "%+.4f" : (d == 5 ? "%+.5f" : "%+.6f")))))
      ) : (
        d == 0 ? "%.0f" : (d == 1 ? "%.1f" : (d == 2 ? "%.2f" : (d == 3 ? "%.3f" :
        (d == 4 ? "%.4f" : (d == 5 ? "%.5f" : "%.6f")))))
      );
      sprintf(out, fmt, v);
    );
    strlen(unit) > 0 ? (
      strcmp(unit, "%") == 0 ? strcat(out, unit) : (strcat(out, " "); strcat(out, unit););
    );
  );
  d;
);

function runtime_knob_mouse(widget_id, owner_id, my, anchor_y, anchor_v)
  local(a, v0, v1)
(
  a = runtime_knob_addr_private(widget_id);
  v0 = a[0];
  v1 = v0;
  (a[1] != 0 && owner_id == widget_id) ? (
    v1 = anchor_v + (anchor_y - my) / runtime_s(runtime_drag_throw) * (a[4] - a[3]);
    v1 = min(max(v1, a[3]), a[4]);
  );
  a[0] = v1;
  v1 != v0;
);

function runtime_knob_wheel(widget_id, owner_id, mx, my, x, y, w, h)
  local(a, v0, v1, n)
(
  a = runtime_knob_addr_private(widget_id);
  v0 = a[0];
  v1 = v0;
  (mouse_wheel != 0 && owner_id == 0 && a[1] != 0 &&
   runtime_hit(mx, my, x, y, w, h)) ? (
    n = a[5] != 0 ? a[5] : (a[4] - a[3]) / 100;
    v1 = v0 + (mouse_wheel / 120) * n;
    v1 = min(max(v1, a[3]), a[4]);
    a[0] = v1;
    mouse_wheel = 0;
  );
  v1 != v0;
);

function runtime_knob_reset(widget_id, owner_id, mx, my, x, y, w, h, trigger)
  local(a, v0)
(
  a = runtime_knob_addr_private(widget_id);
  v0 = a[0];
  (trigger != 0 && a[1] != 0 && runtime_hit(mx, my, x, y, w, h) &&
   ((trigger == 1 && owner_id == 0) || (trigger == 2 && owner_id == widget_id))) ? (
    a[0] = a[3];
  );
  a[0] != v0;
);

function runtime_knob_reset_to(widget_id, owner_id, mx, my, x, y, w, h, trigger, value)
  local(a, v0)
(
  a = runtime_knob_addr_private(widget_id);
  v0 = a[0];
  (trigger != 0 && a[1] != 0 && runtime_hit(mx, my, x, y, w, h) &&
   ((trigger == 1 && owner_id == 0) || (trigger == 2 && owner_id == widget_id))) ? (
    a[0] = min(max(value, a[3]), a[4]);
  );
  a[0] != v0;
);

function runtime_knob_draw(id, x, y, w, h, ring_px, pointer_px, pointer_len, value_px, frac, hover, str, inner_inset, inner_ring_px, show_inner_ring, show_inner_fill, show_outer_fill, pointer_dot, pointer_distance)
  local(px, py, pw, ph, pd, cx, cy, ro, rt, r_outer, inset_px, inner_rt,
        r_inner, r_inner_in, fill_cx, fill_cy, pl, hw, f, ang, ux, uy, nx, ny, r, n, t,
        row_start, row_end, row_count, row_i, row_y, sy, ho0, ho1, ho2, ho3,
        hi0, hi1, hi2, hi3, homax, homin, himax, ba, px_x, px_e, s0, s1, s2,
        s3, cov, tw, th, s_ring, start_x, start_y, min_x, max_x, min_y, max_y,
        sample_x, sample_y, sample_i, sample_j, proj_u, proj_v, half_u, half_v, sx, m,
        dot, r_end, eu, off, oa, one, rf, e0, e1, e2, e3)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0) ? (
    pd = min(pw, ph);
    cx = px + pw * 0.5;
    cy = py + ph * 0.5;
    fill_cx = floor(cx + 0.5) + 0.5;
    fill_cy = floor(cy + 0.5) + 0.5;
    ro = pd * 0.5;
    rt = floor(runtime_s(ring_px));
    r_outer = ro - rt;
    inset_px = floor(runtime_s(inner_inset));
    inner_rt = floor(runtime_s(inner_ring_px));
    r_inner = r_outer - inset_px;
    r_inner_in = r_inner - inner_rt;
    pl = floor(runtime_s(pointer_len));
    hw = floor(runtime_s(pointer_px)) * 0.5;
    f = min(max(frac, 0), 1);
    runtime_color_seed_private();
    oa = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 96 + 11 * 8;
    off = runtime_knob_off != 0 &&
          !(oa[0] == -1 && oa[1] == -1 && oa[2] == -1 && oa[3] == -1 &&
            oa[4] == -1 && oa[5] == -1 && oa[6] == -1 && oa[7] == -1);
    s_ring = off ? RUNTIME_SLOT_KNOB_OFF : (hover ? RUNTIME_SLOT_KNOB_HOVER : RUNTIME_SLOT_KNOB_RING);

    one = 0;
    (show_outer_fill != 0 && r_inner >= 0 && r_outer > r_inner && r_outer > 0) ? (
      runtime_color_apply(id, s_ring, 0, RUNTIME_STATE_IDLE);
      e0 = gfx_r; e1 = gfx_g; e2 = gfx_b; e3 = gfx_a;
      runtime_color_apply(id, off ? RUNTIME_SLOT_KNOB_OFF : RUNTIME_SLOT_KNOB_OUTER_FILL, 0, RUNTIME_STATE_IDLE);
      one = gfx_r == e0 && gfx_g == e1 && gfx_b == e2 && gfx_a == e3;
      one && !off ? (
        runtime_color_apply(id, s_ring, 1, RUNTIME_STATE_IDLE);
        one = gfx_r == e0 && gfx_g == e1 && gfx_b == e2 && gfx_a == e3;
        runtime_color_apply(id, RUNTIME_SLOT_KNOB_OUTER_FILL, 1, RUNTIME_STATE_IDLE);
        one = one && gfx_r == e0 && gfx_g == e1 && gfx_b == e2 && gfx_a == e3;
      );
    );
    rf = one ? ro : r_outer;

    (rt > 0 && r_outer >= 0 && !one) ? (
      row_start = floor(fill_cy - ro - 1);
      row_count = ceil(fill_cy + ro + 1) - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        sy = row_y + 0.5 - fill_cy;
        ho0 = sqrt(max(0, (ro + 0.5) * (ro + 0.5) - sy * sy));
        hi0 = max(0, r_outer - 0.5);
        hi0 = sqrt(max(0, hi0 * hi0 - sy * sy));
        ho1 = floor(fill_cx - ho0); hi1 = ceil(fill_cx - hi0);
        n = 0;
        loop(2,
          sx = n == 0 ? ho1 : max(hi1, floor(fill_cx + hi0));
          loop(max(0, (n == 0 ? hi1 : ceil(fill_cx + ho0)) - sx),
            r = sqrt((sx + 0.5 - fill_cx) * (sx + 0.5 - fill_cx) + sy * sy);
            cov = min(ro, r + 0.5) - max(r_outer, r - 0.5);
            cov > 0 ? (
              t = (min(ro, max(r_outer, r)) - r_outer) / rt;
              runtime_color_apply(id, s_ring, off ? 0 : t, RUNTIME_STATE_IDLE);
              gfx_a *= min(1, cov);
              gfx_rect(sx, row_y, 1, 1);
            );
            sx += 1;
          );
          n += 1;
        );
        row_i += 1;
      );
    );

    (show_outer_fill != 0 && r_inner >= 0 && rf > r_inner && rf > 0) ? (
      row_start = floor(fill_cy - rf);
      row_end = ceil(fill_cy + rf);
      row_count = row_end - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        t = row_count > 1 ? row_i / (row_count - 1) : 0;
        runtime_color_apply(id, off ? RUNTIME_SLOT_KNOB_OFF : RUNTIME_SLOT_KNOB_OUTER_FILL, off ? 0 : t, RUNTIME_STATE_IDLE);
        sy = row_y + 0.125 - fill_cy;
        ho0 = abs(sy) < rf ? sqrt(rf * rf - sy * sy) : 0;
        hi0 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        sy = row_y + 0.375 - fill_cy;
        ho1 = abs(sy) < rf ? sqrt(rf * rf - sy * sy) : 0;
        hi1 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        sy = row_y + 0.625 - fill_cy;
        ho2 = abs(sy) < rf ? sqrt(rf * rf - sy * sy) : 0;
        hi2 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        sy = row_y + 0.875 - fill_cy;
        ho3 = abs(sy) < rf ? sqrt(rf * rf - sy * sy) : 0;
        hi3 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        homax = max(max(ho0, ho1), max(ho2, ho3));
        homin = min(min(ho0, ho1), min(ho2, ho3));
        himax = max(max(hi0, hi1), max(hi2, hi3));
        homax > 0 ? (
          ba = gfx_a;
          px_x = floor(fill_cx - homax);
          px_e = ceil(fill_cx + homax);
          s0 = ceil(fill_cx - homin);
          s1 = floor(fill_cx - himax);
          s2 = ceil(fill_cx + himax);
          s3 = floor(fill_cx + homin);
          while (px_x < px_e) (
            px_x >= s0 && px_x < s1 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s1 - px_x, 1);
              px_x = s1;
            ) : px_x >= s2 && px_x < s3 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s3 - px_x, 1);
              px_x = s3;
            ) : (
              cov = 0.25 * (
                max(0, min(px_x + 1, fill_cx - hi0) - max(px_x, fill_cx - ho0)) + max(0, min(px_x + 1, fill_cx + ho0) - max(px_x, fill_cx + hi0)) +
                max(0, min(px_x + 1, fill_cx - hi1) - max(px_x, fill_cx - ho1)) + max(0, min(px_x + 1, fill_cx + ho1) - max(px_x, fill_cx + hi1)) +
                max(0, min(px_x + 1, fill_cx - hi2) - max(px_x, fill_cx - ho2)) + max(0, min(px_x + 1, fill_cx + ho2) - max(px_x, fill_cx + hi2)) +
                max(0, min(px_x + 1, fill_cx - hi3) - max(px_x, fill_cx - ho3)) + max(0, min(px_x + 1, fill_cx + ho3) - max(px_x, fill_cx + hi3)));
              cov > 0 ? (
                gfx_a = ba * min(cov, 1);
                gfx_rect(px_x, row_y, 1, 1);
              );
              px_x += 1;
            );
          );
          gfx_a = ba;
        );
        row_i += 1;
      );
    );

    (show_inner_ring != 0 && inner_rt > 0 && r_inner_in >= 0) ? (
      row_start = floor(fill_cy - r_inner - 1);
      row_count = ceil(fill_cy + r_inner + 1) - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        sy = row_y + 0.5 - fill_cy;
        ho0 = sqrt(max(0, (r_inner + 0.5) * (r_inner + 0.5) - sy * sy));
        hi0 = max(0, r_inner_in - 0.5);
        hi0 = sqrt(max(0, hi0 * hi0 - sy * sy));
        ho1 = floor(fill_cx - ho0); hi1 = ceil(fill_cx - hi0);
        n = 0;
        loop(2,
          sx = n == 0 ? ho1 : max(hi1, floor(fill_cx + hi0));
          loop(max(0, (n == 0 ? hi1 : ceil(fill_cx + ho0)) - sx),
            r = sqrt((sx + 0.5 - fill_cx) * (sx + 0.5 - fill_cx) + sy * sy);
            cov = min(r_inner, r + 0.5) - max(r_inner_in, r - 0.5);
            cov > 0 ? (
              t = (min(r_inner, max(r_inner_in, r)) - r_inner_in) / inner_rt;
              runtime_color_apply(id, RUNTIME_SLOT_KNOB_INNER_RING, t, RUNTIME_STATE_IDLE);
              gfx_a *= min(1, cov);
              gfx_rect(sx, row_y, 1, 1);
            );
            sx += 1;
          );
          n += 1;
        );
        row_i += 1;
      );
    );

    (show_inner_fill != 0 && r_inner_in > 0) ? (
      row_start = floor(fill_cy - r_inner_in);
      row_end = ceil(fill_cy + r_inner_in);
      row_count = row_end - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        t = row_count > 1 ? row_i / (row_count - 1) : 0;
        runtime_color_apply(id, RUNTIME_SLOT_KNOB_INNER_FILL, t, RUNTIME_STATE_IDLE);
        sy = row_y + 0.125 - fill_cy;
        ho0 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi0 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        sy = row_y + 0.375 - fill_cy;
        ho1 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi1 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        sy = row_y + 0.625 - fill_cy;
        ho2 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi2 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        sy = row_y + 0.875 - fill_cy;
        ho3 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi3 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        homax = max(max(ho0, ho1), max(ho2, ho3));
        homin = min(min(ho0, ho1), min(ho2, ho3));
        himax = max(max(hi0, hi1), max(hi2, hi3));
        homax > 0 ? (
          ba = gfx_a;
          px_x = floor(fill_cx - homax);
          px_e = ceil(fill_cx + homax);
          s0 = ceil(fill_cx - homin);
          s1 = floor(fill_cx - himax);
          s2 = ceil(fill_cx + himax);
          s3 = floor(fill_cx + homin);
          while (px_x < px_e) (
            px_x >= s0 && px_x < s1 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s1 - px_x, 1);
              px_x = s1;
            ) : px_x >= s2 && px_x < s3 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s3 - px_x, 1);
              px_x = s3;
            ) : (
              cov = 0.25 * (
                max(0, min(px_x + 1, fill_cx - hi0) - max(px_x, fill_cx - ho0)) + max(0, min(px_x + 1, fill_cx + ho0) - max(px_x, fill_cx + hi0)) +
                max(0, min(px_x + 1, fill_cx - hi1) - max(px_x, fill_cx - ho1)) + max(0, min(px_x + 1, fill_cx + ho1) - max(px_x, fill_cx + hi1)) +
                max(0, min(px_x + 1, fill_cx - hi2) - max(px_x, fill_cx - ho2)) + max(0, min(px_x + 1, fill_cx + ho2) - max(px_x, fill_cx + hi2)) +
                max(0, min(px_x + 1, fill_cx - hi3) - max(px_x, fill_cx - ho3)) + max(0, min(px_x + 1, fill_cx + ho3) - max(px_x, fill_cx + hi3)));
              cov > 0 ? (
                gfx_a = ba * min(cov, 1);
                gfx_rect(px_x, row_y, 1, 1);
              );
              px_x += 1;
            );
          );
          gfx_a = ba;
        );
        row_i += 1;
      );
    );

    dot = pointer_dot != 0;
    r_end = dot ? ro - floor(runtime_s(pointer_distance)) : r_outer;
    (pl > 0 && hw >= 0.5 && (dot || r_outer - pl >= 0)) ? (
      runtime_color_apply(id, RUNTIME_SLOT_KNOB_POINTER, 0, RUNTIME_STATE_IDLE);
      ang = f * 2 * $pi;
      ux = sin(ang);
      uy = -cos(ang);
      nx = uy;
      ny = -ux;
      start_x = cx + ux * (r_end - pl);
      start_y = cy + uy * (r_end - pl);
      min_x = min(start_x, cx + ux * r_end) - abs(nx) * hw;
      max_x = max(start_x, cx + ux * r_end) + abs(nx) * hw;
      min_y = min(start_y, cy + uy * r_end) - abs(ny) * hw;
      max_y = max(start_y, cy + uy * r_end) + abs(ny) * hw;
      half_u = (abs(ux) + abs(uy)) * 0.5;
      half_v = (abs(nx) + abs(ny)) * 0.5;
      row_start = floor(min_y);
      row_end = ceil(max_y);
      row_count = row_end - row_start;
      row_i = 0;
      ba = gfx_a;
      loop(row_count,
        row_y = row_start + row_i;
        px_x = floor(min_x);
        px_e = ceil(max_x);
        while (px_x < px_e) (
          sample_x = px_x + 0.5;
          sample_y = row_y + 0.5;
          proj_u = (sample_x - start_x) * ux + (sample_y - start_y) * uy;
          proj_v = (sample_x - start_x) * nx + (sample_y - start_y) * ny;
          (dot == 0 && proj_u - half_u >= 0 && proj_u + half_u <= pl &&
           proj_v - half_v >= -hw && proj_v + half_v <= hw) ? (
            cov = 1;
          ) : (
            (px_x + 1 <= min_x || px_x >= max_x || row_y + 1 <= min_y || row_y >= max_y ||
             proj_u + half_u <= 0 || proj_u - half_u >= pl ||
             proj_v + half_v <= -hw || proj_v - half_v >= hw) ? (
              cov = 0;
            ) : (
              cov = 0;
              sample_i = 0;
              loop(16,
                sample_j = 0;
                loop(16,
                  sample_x = px_x + (sample_i + 0.5) / 16;
                  sample_y = row_y + (sample_j + 0.5) / 16;
                  proj_u = (sample_x - start_x) * ux + (sample_y - start_y) * uy;
                  proj_v = (sample_x - start_x) * nx + (sample_y - start_y) * ny;
                  eu = (proj_u - pl * 0.5) / (pl * 0.5);
                  (dot ? (eu * eu + (proj_v / hw) * (proj_v / hw) <= 1) :
                   (proj_u >= 0 && proj_u <= pl && abs(proj_v) <= hw)) ? cov += 1;
                  sample_j += 1;
                );
                sample_i += 1;
              );
              cov /= 256;
            );
          );
          cov > 0 ? (
            gfx_a = ba * cov;
            gfx_rect(px_x, row_y, 1, 1);
          );
          px_x += 1;
        );
        row_i += 1;
      );
      gfx_a = ba;
    );

    strlen(str) > 0 ? (
      runtime_text_font_private(runtime_sf(value_px));
      m = runtime_text_ink_private(runtime_sf(value_px));
      gfx_measurestr(str, tw, th);
      gfx_x = floor(cx - tw * 0.5);
      gfx_y = floor(cy - m);
