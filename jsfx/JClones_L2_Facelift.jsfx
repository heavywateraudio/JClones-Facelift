    gfx_x = px + floor((pw - tw) * 0.5);
    gfx_y = py + floor((ph - th) * 0.5);
    runtime_color_literal(text_r, text_g, text_b, text_a, text_r, text_g, text_b, text_a, 0,
                         RUNTIME_STATE_IDLE);
    runtime_text_draw_private(str, 0, 1);
  );
  runtime_text_style(0, 0);
