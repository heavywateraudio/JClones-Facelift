function runtime_numbox_addr_private(widget_id)
(
  RUNTIME_ARENA_BASE + RUNTIME_WIDGET_OFF + (widget_id - 1) * 8;
);

function runtime_numbox_decimals_private(vstep)
  local(d, i, s)
(
  vstep == 0 ? 2 : (
    d = 6;
    i = 6;
    loop(7,
      s = abs(vstep) * pow(10, i);
      abs(s - floor(s + 0.5)) <= 0.000000001 ? d = i;
      i -= 1;
    );
    d;
  );
);

function runtime_numbox_init(widget_id, value, enabled, flags, vmin, vmax, vstep)
  local(a)
(
  a = runtime_numbox_addr_private(widget_id);
  a[3] = vmin;
  a[4] = vmax;
  a[5] = vstep;
  a[6] = runtime_numbox_decimals_private(vstep);
  a[0] = min(max(value, vmin), vmax);
  a[1] = enabled != 0 ? 1 : 0;
  a[2] = flags;
  a[7] = -1;
);

function runtime_numbox_get(widget_id)
  local(a)
(
  a = runtime_numbox_addr_private(widget_id);
  a[0];
);

function runtime_numbox_set(widget_id, value)
  local(a)
(
  a = runtime_numbox_addr_private(widget_id);
  a[0] = min(max(value, a[3]), a[4]);
);

function runtime_numbox_format(widget_id, out)
  local(a, d, v)
(
  a = runtime_numbox_addr_private(widget_id);
  d = a[6];
  v = a[0];
  floor(abs(v) * pow(10, d) + 0.5) == 0 ? v = 0;
  runtime_text_sign = v < 0 ? -1 : (v > 0 ? 1 : 0);
  d == 0 ? sprintf(out, "%.0f", v) :
  d == 1 ? sprintf(out, "%.1f", v) :
  d == 2 ? sprintf(out, "%.2f", v) :
  d == 3 ? sprintf(out, "%.3f", v) :
  d == 4 ? sprintf(out, "%.4f", v) :
  d == 5 ? sprintf(out, "%.5f", v) :
           sprintf(out, "%.6f", v);
  d;
);

function runtime_numbox_format_text(widget_id, out, decimals, flags, unit, below)
  local(a, d, v, m, r, fmt)
(
  a = runtime_numbox_addr_private(widget_id);
  v = a[0];
  d = decimals >= 0 ? decimals : a[6];
  runtime_text_sign = v < 0 ? -1 : (v > 0 ? 1 : 0);
  (v == a[3] && strlen(below) > 0) ? (
    strcpy(out, below);
  ) : (
    m = abs(v);
    ((flags & 2) && m >= 1000) ? (
      r = m >= 1000000 ? floor(m / 100000 + 0.5) : floor(m / 100 + 0.5);
      r = (v < 0 ? -r : r) / 10;
      fmt = (r == floor(r)) ? (((flags & 1) && r > 0) ? "%+.0f" : "%.0f")
                            : (((flags & 1) && r > 0) ? "%+.1f" : "%.1f");
      sprintf(out, fmt, r);
      strcat(out, m >= 1000000 ? "M" : "k");
    ) : (
      floor(m * pow(10, d) + 0.5) == 0 ? (v = 0; runtime_text_sign = 0;);
      fmt = ((flags & 1) && v > 0) ? (
        d == 0 ? "%+.0f" : (d == 1 ? "%+.1f" : (d == 2 ? "%+.2f" : (d == 3 ? "%+.3f" :
        (d == 4 ? "%+.4f" : (d == 5 ? "%+.5f" : "%+.6f")))))
      ) : (
        d == 0 ? "%.0f" : (d == 1 ? "%.1f" : (d == 2 ? "%.2f" : (d == 3 ? "%.3f" :
        (d == 4 ? "%.4f" : (d == 5 ? "%.5f" : "%.6f")))))
      );
      sprintf(out, fmt, v);
    );
    strlen(unit) > 0 ? (
      strcmp(unit, "%") == 0 ? strcat(out, unit) : (strcat(out, " "); strcat(out, unit););
    );
  );
  d;
);

function runtime_numbox_mouse(widget_id, owner_id, my, anchor_y, anchor_v)
  local(a, v0, v1)
(
  a = runtime_numbox_addr_private(widget_id);
  v0 = a[0];
  v1 = v0;
  (a[1] != 0 && owner_id == widget_id) ? (
    v1 = anchor_v + (anchor_y - my) / runtime_s(runtime_drag_throw) * (a[4] - a[3]);
    v1 = min(max(v1, a[3]), a[4]);
  );
  a[0] = v1;
  v1 != v0;
);

function runtime_numbox_reset(widget_id, owner_id, mx, my, x, y, w, h, trigger)
  local(a, v0)
(
  a = runtime_numbox_addr_private(widget_id);
  v0 = a[0];
  (trigger == 1 && owner_id == 0 && a[1] != 0 &&
   runtime_hit(mx, my, x, y, w, h)) ? (
    a[0] = a[3];
  );
  a[0] != v0;
);

function runtime_numbox_reset_to(widget_id, owner_id, mx, my, x, y, w, h, trigger, value)
  local(a, v0)
(
  a = runtime_numbox_addr_private(widget_id);
  v0 = a[0];
  (trigger == 1 && owner_id == 0 && a[1] != 0 &&
   runtime_hit(mx, my, x, y, w, h)) ? (
    a[0] = min(max(value, a[3]), a[4]);
  );
  a[0] != v0;
);

function runtime_numbox_draw(id, x, y, w, h, radius, caret_px, value_px, editing, str)
  local(px, py, pw, ph, pr, cx, cy, sx, tw, th, cw, ch, s_fill, s_text, m)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  pr = floor(runtime_s(radius));
  (pw > 0 && ph > 0) ? (
    cx = px + pw * 0.5;
    cy = py + ph * 0.5;
    sx = floor(cx);
    tw = 0;
    s_fill = editing ? RUNTIME_SLOT_NUMBOX_EDIT_FILL : RUNTIME_SLOT_NUMBOX_FILL;
    s_text = editing ? RUNTIME_SLOT_NUMBOX_EDIT_TEXT :
             (runtime_text_sign < 0 ? RUNTIME_SLOT_NUMBOX_NEGATIVE :
             (runtime_text_sign > 0 ? RUNTIME_SLOT_NUMBOX_POSITIVE : RUNTIME_SLOT_NUMBOX_TEXT));
    runtime_color_apply(id, s_fill, 0, RUNTIME_STATE_IDLE);
    runtime_rr_fill(px, py, pw, ph, pr);
    m = 0;
    strlen(str) > 0 ? (
      runtime_text_font_private(runtime_sf(value_px));
      m = runtime_text_ink_private(runtime_sf(value_px));
      gfx_measurestr(str, tw, th);
      sx = floor(cx - tw * 0.5);
      gfx_x = sx;
      gfx_y = floor(cy - m);
      runtime_color_apply(id, s_text, 0, RUNTIME_STATE_IDLE);
      runtime_text_draw_private(str, 0, 0);
    );
    editing ? (
      cw = floor(runtime_s(caret_px));
      ch = runtime_sf(value_px);
      (cw > 0 && ch > 0) ? (
        runtime_color_apply(id, RUNTIME_SLOT_NUMBOX_ACCENT, 0, RUNTIME_STATE_IDLE);
        gfx_rect(sx + tw, floor(floor(cy - m) + m - ch * 0.5), cw, ch);
      );
    );
  );
  runtime_text_style(0, 0);
  runtime_text_sign = 0;
);

function runtime_numbox_draw_literal(x, y, w, h, radius, caret_px, value_px, editing, str, fill_r, fill_g, fill_b, fill_a, edit_fill_r, edit_fill_g, edit_fill_b, edit_fill_a, text_r, text_g, text_b, text_a, edit_text_r, edit_text_g, edit_text_b, edit_text_a, accent_r, accent_g, accent_b, accent_a, negative_r, negative_g, negative_b, negative_a, positive_r, positive_g, positive_b, positive_a)
  local(px, py, pw, ph, pr, cx, cy, sx, tw, th, cw, ch, fr, fg, fb, fa, tr, tg, tb, ta, m)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  pr = floor(runtime_s(radius));
  (pw > 0 && ph > 0) ? (
    cx = px + pw * 0.5;
    cy = py + ph * 0.5;
    sx = floor(cx);
    tw = 0;
    fr = editing ? edit_fill_r : fill_r;
    fg = editing ? edit_fill_g : fill_g;
    fb = editing ? edit_fill_b : fill_b;
    fa = editing ? edit_fill_a : fill_a;
    tr = editing ? edit_text_r : (runtime_text_sign < 0 ? negative_r : (runtime_text_sign > 0 ? positive_r : text_r));
    tg = editing ? edit_text_g : (runtime_text_sign < 0 ? negative_g : (runtime_text_sign > 0 ? positive_g : text_g));
    tb = editing ? edit_text_b : (runtime_text_sign < 0 ? negative_b : (runtime_text_sign > 0 ? positive_b : text_b));
    ta = editing ? edit_text_a : (runtime_text_sign < 0 ? negative_a : (runtime_text_sign > 0 ? positive_a : text_a));
    runtime_color_literal(fr, fg, fb, fa, fr, fg, fb, fa, 0, RUNTIME_STATE_IDLE);
    runtime_rr_fill(px, py, pw, ph, pr);
    m = 0;
    strlen(str) > 0 ? (
      runtime_text_font_private(runtime_sf(value_px));
      m = runtime_text_ink_private(runtime_sf(value_px));
      gfx_measurestr(str, tw, th);
      sx = floor(cx - tw * 0.5);
      gfx_x = sx;
      gfx_y = floor(cy - m);
      runtime_color_literal(tr, tg, tb, ta, tr, tg, tb, ta, 0, RUNTIME_STATE_IDLE);
      runtime_text_draw_private(str, 0, 0);
    );
    editing ? (
      cw = floor(runtime_s(caret_px));
      ch = runtime_sf(value_px);
      (cw > 0 && ch > 0) ? (
        runtime_color_literal(accent_r, accent_g, accent_b, accent_a, accent_r, accent_g, accent_b, accent_a, 0, RUNTIME_STATE_IDLE);
        gfx_rect(sx + tw, floor(floor(cy - m) + m - ch * 0.5), cw, ch);
      );
    );
  );
  runtime_text_style(0, 0);
  runtime_text_sign = 0;
);

function runtime_meter_span_private(id, slot, x, y, w, h, px, py, pw, ph, f0, f1, direction)
  local(e0, e1, rx, ry, rw, rh)
(
  f1 > f0 ? (
    direction == 0 ? (
      e0 = floor(runtime_y(y + h - f0 * h));
      e1 = floor(runtime_y(y + h - f1 * h));
      e0 = min(py + ph, max(py, e0));
      e1 = min(py + ph, max(py, e1));
      rx = px;
      ry = e1;
      rw = pw;
      rh = e0 - e1;
    ) : direction == 1 ? (
      e0 = floor(runtime_x(x + f0 * w));
      e1 = floor(runtime_x(x + f1 * w));
      e0 = min(px + pw, max(px, e0));
      e1 = min(px + pw, max(px, e1));
      rx = e0;
      ry = py;
      rw = e1 - e0;
      rh = ph;
    ) : direction == 2 ? (
      e0 = floor(runtime_y(y + f0 * h));
      e1 = floor(runtime_y(y + f1 * h));
      e0 = min(py + ph, max(py, e0));
      e1 = min(py + ph, max(py, e1));
      rx = px;
      ry = e0;
      rw = pw;
      rh = e1 - e0;
    ) : (
      e0 = floor(runtime_x(x + w - f0 * w));
      e1 = floor(runtime_x(x + w - f1 * w));
      e0 = min(px + pw, max(px, e0));
      e1 = min(px + pw, max(px, e1));
      rx = e1;
      ry = py;
      rw = e0 - e1;
      rh = ph;
    );
    (rw > 0 && rh > 0) ? (
      runtime_color_apply(id, slot, 0, RUNTIME_STATE_IDLE);
      gfx_rect(rx, ry, rw, rh);
    );
  );
);

function runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, f0, f1, direction, red, green, blue, alpha)
  local(e0, e1, rx, ry, rw, rh)
(
  f1 > f0 ? (
    direction == 0 ? (
      e0 = floor(runtime_y(y + h - f0 * h));
      e1 = floor(runtime_y(y + h - f1 * h));
      e0 = min(py + ph, max(py, e0));
      e1 = min(py + ph, max(py, e1));
      rx = px;
      ry = e1;
      rw = pw;
      rh = e0 - e1;
    ) : direction == 1 ? (
      e0 = floor(runtime_x(x + f0 * w));
      e1 = floor(runtime_x(x + f1 * w));
      e0 = min(px + pw, max(px, e0));
      e1 = min(px + pw, max(px, e1));
      rx = e0;
      ry = py;
      rw = e1 - e0;
      rh = ph;
    ) : direction == 2 ? (
      e0 = floor(runtime_y(y + f0 * h));
      e1 = floor(runtime_y(y + f1 * h));
      e0 = min(py + ph, max(py, e0));
      e1 = min(py + ph, max(py, e1));
      rx = px;
      ry = e0;
      rw = pw;
      rh = e1 - e0;
    ) : (
      e0 = floor(runtime_x(x + w - f0 * w));
      e1 = floor(runtime_x(x + w - f1 * w));
      e0 = min(px + pw, max(px, e0));
      e1 = min(px + pw, max(px, e1));
      rx = e1;
      ry = py;
      rw = e0 - e1;
      rh = ph;
    );
    (rw > 0 && rh > 0) ? (
      runtime_color_literal(red, green, blue, alpha, red, green, blue, alpha, 0,
                            RUNTIME_STATE_IDLE);
      gfx_rect(rx, ry, rw, rh);
    );
  );
);

function runtime_meter_draw(id, x, y, w, h, level, scale_min, scale_max, direction, zone2_on, zone2_start, zone3_on, zone3_start)
  local(px, py, pw, ph, scale_range, fraction, zone2_fraction, zone3_fraction,
        zone2_enabled, zone3_enabled, zone2_end, zone1_end)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0 && scale_max > scale_min) ? (
    scale_range = scale_max - scale_min;
    fraction = min(1, max(0, (level - scale_min) / scale_range));
    zone2_fraction = min(1, max(0, (zone2_start - scale_min) / scale_range));
    zone3_fraction = min(1, max(0, (zone3_start - scale_min) / scale_range));
    zone2_enabled = zone2_on != 0;
    zone3_enabled = zone3_on != 0;
    zone2_end = zone3_enabled ? min(fraction, zone3_fraction) : fraction;
    zone1_end = zone2_enabled ? min(fraction, zone2_fraction) : fraction;
    zone1_end = zone3_enabled ? min(zone1_end, zone3_fraction) : zone1_end;
    zone3_enabled ? runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE3, x, y, w, h, px, py, pw, ph, zone3_fraction, fraction, direction);
    zone2_enabled ? runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE2, x, y, w, h, px, py, pw, ph, zone2_fraction, zone2_end, direction);
    runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE1, x, y, w, h, px, py, pw, ph, 0, zone1_end, direction);
  );
);

function runtime_meter_draw_literal(x, y, w, h, level, scale_min, scale_max, direction, zone2_on, zone2_start, zone3_on, zone3_start, zone1_r, zone1_g, zone1_b, zone1_a, zone2_r, zone2_g, zone2_b, zone2_a, zone3_r, zone3_g, zone3_b, zone3_a)
  local(px, py, pw, ph, scale_range, fraction, zone2_fraction, zone3_fraction,
        zone2_enabled, zone3_enabled, zone2_end, zone1_end)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0 && scale_max > scale_min) ? (
    scale_range = scale_max - scale_min;
    fraction = min(1, max(0, (level - scale_min) / scale_range));
    zone2_fraction = min(1, max(0, (zone2_start - scale_min) / scale_range));
    zone3_fraction = min(1, max(0, (zone3_start - scale_min) / scale_range));
    zone2_enabled = zone2_on != 0;
    zone3_enabled = zone3_on != 0;
    zone2_end = zone3_enabled ? min(fraction, zone3_fraction) : fraction;
    zone1_end = zone2_enabled ? min(fraction, zone2_fraction) : fraction;
    zone1_end = zone3_enabled ? min(zone1_end, zone3_fraction) : zone1_end;
    zone3_enabled ? runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, zone3_fraction, fraction, direction, zone3_r, zone3_g, zone3_b, zone3_a);
    zone2_enabled ? runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, zone2_fraction, zone2_end, direction, zone2_r, zone2_g, zone2_b, zone2_a);
    runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, 0, zone1_end, direction, zone1_r, zone1_g, zone1_b, zone1_a);
  );
);

function runtime_meter_draw_from(id, x, y, w, h, level, scale_min, scale_max, direction, starts_at, zone2_on, zone2_start, zone3_on, zone3_start)
  local(px, py, pw, ph, scale_range, fraction, zone2_fraction, zone3_fraction,
        zone2_enabled, zone3_enabled, zone2_end, zone1_end)
(
  starts_at == 0 ? (
    runtime_meter_draw(id, x, y, w, h, level, scale_min, scale_max, direction, zone2_on, zone2_start, zone3_on, zone3_start);
  ) : (
    px = floor(runtime_x(x));
    py = floor(runtime_y(y));
    pw = floor(runtime_x(x + w)) - px;
    ph = floor(runtime_y(y + h)) - py;
    (pw > 0 && ph > 0 && scale_max > scale_min && level > -1000000) ? (
      scale_range = scale_max - scale_min;
      fraction = min(1, max(0, (level - scale_min) / scale_range));
      zone2_fraction = min(1, max(0, (zone2_start - scale_min) / scale_range));
      zone3_fraction = min(1, max(0, (zone3_start - scale_min) / scale_range));
      zone2_enabled = zone2_on != 0;
      zone3_enabled = zone3_on != 0;
      zone2_end = zone3_enabled ? max(fraction, zone3_fraction) : fraction;
      zone1_end = zone2_enabled ? max(fraction, zone2_fraction) : fraction;
      zone1_end = zone3_enabled ? max(zone1_end, zone3_fraction) : zone1_end;
      zone3_enabled ? runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE3, x, y, w, h, px, py, pw, ph, 1 - zone3_fraction, 1 - fraction, direction);
      zone2_enabled ? runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE2, x, y, w, h, px, py, pw, ph, 1 - zone2_fraction, 1 - zone2_end, direction);
      runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE1, x, y, w, h, px, py, pw, ph, 0, 1 - zone1_end, direction);
    );
  );
);

function runtime_meter_draw_from_literal(x, y, w, h, level, scale_min, scale_max, direction, starts_at, zone2_on, zone2_start, zone3_on, zone3_start, zone1_r, zone1_g, zone1_b, zone1_a, zone2_r, zone2_g, zone2_b, zone2_a, zone3_r, zone3_g, zone3_b, zone3_a)
  local(px, py, pw, ph, scale_range, fraction, zone2_fraction, zone3_fraction,
        zone2_enabled, zone3_enabled, zone2_end, zone1_end)
(
  starts_at == 0 ? (
    runtime_meter_draw_literal(x, y, w, h, level, scale_min, scale_max, direction, zone2_on, zone2_start, zone3_on, zone3_start, zone1_r, zone1_g, zone1_b, zone1_a, zone2_r, zone2_g, zone2_b, zone2_a, zone3_r, zone3_g, zone3_b, zone3_a);
  ) : (
    px = floor(runtime_x(x));
    py = floor(runtime_y(y));
    pw = floor(runtime_x(x + w)) - px;
    ph = floor(runtime_y(y + h)) - py;
    (pw > 0 && ph > 0 && scale_max > scale_min && level > -1000000) ? (
      scale_range = scale_max - scale_min;
      fraction = min(1, max(0, (level - scale_min) / scale_range));
      zone2_fraction = min(1, max(0, (zone2_start - scale_min) / scale_range));
      zone3_fraction = min(1, max(0, (zone3_start - scale_min) / scale_range));
      zone2_enabled = zone2_on != 0;
      zone3_enabled = zone3_on != 0;
      zone2_end = zone3_enabled ? max(fraction, zone3_fraction) : fraction;
      zone1_end = zone2_enabled ? max(fraction, zone2_fraction) : fraction;
      zone1_end = zone3_enabled ? max(zone1_end, zone3_fraction) : zone1_end;
      zone3_enabled ? runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, 1 - zone3_fraction, 1 - fraction, direction, zone3_r, zone3_g, zone3_b, zone3_a);
      zone2_enabled ? runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, 1 - zone2_fraction, 1 - zone2_end, direction, zone2_r, zone2_g, zone2_b, zone2_a);
      runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, 0, 1 - zone1_end, direction, zone1_r, zone1_g, zone1_b, zone1_a);
    );
  );
);

function runtime_meter_track_draw(id, x, y, w, h)
  local(px, py, pw, ph)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0) ? (
    runtime_color_apply(id, RUNTIME_SLOT_METER_OFF, 0, RUNTIME_STATE_IDLE);
    gfx_rect(px, py, pw, ph);
  );
);

function runtime_meter_track_draw_literal(x, y, w, h, off_r, off_g, off_b, off_a)
  local(px, py, pw, ph)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0) ? (
    runtime_color_literal(off_r, off_g, off_b, off_a, off_r, off_g, off_b, off_a, 0,
                          RUNTIME_STATE_IDLE);
    gfx_rect(px, py, pw, ph);
  );
);

function runtime_led_cover_private(col, row, half)
  local(n, i, j, dx, dy)
(
  n = 0;
  j = 0;
  loop(4,
    dy = row + (j + 0.5) / 4 - half;
    i = 0;
    loop(4,
      dx = col + (i + 0.5) / 4 - half;
      dx * dx + dy * dy < half * half ? n += 1;
      i += 1;
    );
    j += 1;
  );
  n / 16;
);

function runtime_led_fill_private(px, py, pw, ph, shape)
  local(d, sx, sy, half, base, row, y0, y1, ynear, yfar, win, wout, i0, i1, o0, o1, col, cov)
(
  shape == 1 ? (
    gfx_rect(px, py, pw, ph);
  ) : (
    d = min(pw, ph);
    sx = px + floor((pw - d) / 2);
    sy = py + floor((ph - d) / 2);
    half = d / 2;
    base = gfx_a;
    row = 0;
    loop(d,
      y0 = row - half;
      y1 = row + 1 - half;
      yfar = max(abs(y0), abs(y1));
      ynear = (y0 < 0 && y1 > 0) ? 0 : min(abs(y0), abs(y1));
      win = sqrt(max(0, half * half - yfar * yfar));
      wout = sqrt(max(0, half * half - ynear * ynear));
      i0 = ceil(half - win);
      i1 = floor(half + win);
      o0 = max(0, floor(half - wout));
      o1 = min(d, ceil(half + wout));
      i1 <= i0 ? (
        i0 = o1;
        i1 = o1;
      );
      gfx_a = base;
      i1 > i0 ? gfx_rect(sx + i0, sy + row, i1 - i0, 1);
      col = o0;
      loop(i0 - o0,
        cov = runtime_led_cover_private(col, row, half);
        cov > 0 ? (
          gfx_a = base * cov;
          gfx_rect(sx + col, sy + row, 1, 1);
        );
        col += 1;
      );
      col = i1;
      loop(o1 - i1,
        cov = runtime_led_cover_private(col, row, half);
        cov > 0 ? (
          gfx_a = base * cov;
