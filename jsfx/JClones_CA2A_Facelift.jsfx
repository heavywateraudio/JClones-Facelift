function runtime_color_state_factor_private(state)
(
  state == RUNTIME_STATE_HOVER    ? 1.15 :
  state == RUNTIME_STATE_ACTIVE   ? 1.30 :
  state == RUNTIME_STATE_DISABLED ? 0.45 :
                                     1;
);

function runtime_dim_set(dim)
  local(d)
(
  d = dim;
  d * 0 == 0 ? runtime_dim = min(1, max(0, d));
  runtime_dim;
);

function runtime_color_set(id, slot, a_r, a_g, a_b, a_a, b_r, b_g, b_b, b_a)
  local(palette_row, record_row, addr)
(
  runtime_color_seed_private();
  palette_row = floor(slot / 11);
  record_row = slot - palette_row * 11;
  addr = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88 + record_row * 8;
  addr[0] = a_r;
  addr[1] = a_g;
  addr[2] = a_b;
  addr[3] = a_a;
  addr[4] = b_r;
  addr[5] = b_g;
  addr[6] = b_b;
  addr[7] = b_a;
);

function runtime_color_apply(id, slot, t, state)
  local(palette_row, record_row, addr,
        a_r, a_g, a_b, a_a, b_r, b_g, b_b, b_a,
        factor, r, g, b, a)
(
  runtime_color_seed_private();
  palette_row = floor(slot / 11);
  record_row = slot - palette_row * 11;
  addr = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88 + record_row * 8;

  palette_row >= 45 &&
  addr[0] == -1 && addr[1] == -1 && addr[2] == -1 && addr[3] == -1 &&
  addr[4] == -1 && addr[5] == -1 && addr[6] == -1 && addr[7] == -1 ? (
    palette_row == 45 ? (
      palette_row = 2;
      addr = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88;
    ) : (
      palette_row = 5;
      addr = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88 + 3 * 8;
    );
  );
  palette_row >= 41 && palette_row <= 44 &&
  addr[0] == -1 && addr[1] == -1 && addr[2] == -1 && addr[3] == -1 &&
  addr[4] == -1 && addr[5] == -1 && addr[6] == -1 && addr[7] == -1 ? (
    palette_row <= 42 ? (
      palette_row = 11;
      addr = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88 + 3 * 8;
    ) : (
      palette_row = 15;
      addr = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88 + 2 * 8;
    );
  );
  palette_row == 11 &&
  addr[0] == -1 && addr[1] == -1 && addr[2] == -1 && addr[3] == -1 &&
  addr[4] == -1 && addr[5] == -1 && addr[6] == -1 && addr[7] == -1 ? (
    palette_row = 10;
    addr = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88 + 2 * 8;
  );

  addr[0] == -1 && addr[1] == -1 && addr[2] == -1 && addr[3] == -1 &&
  addr[4] == -1 && addr[5] == -1 && addr[6] == -1 && addr[7] == -1 ? (
    a_r = runtime_color_default_private(palette_row, 0);
    a_g = runtime_color_default_private(palette_row, 1);
    a_b = runtime_color_default_private(palette_row, 2);
    a_a = runtime_color_default_private(palette_row, 3);
    b_r = a_r;
    b_g = a_g;
    b_b = a_b;
    b_a = a_a;
  ) : (
    a_r = addr[0];
    a_g = addr[1];
    a_b = addr[2];
    a_a = addr[3];
    b_r = addr[4];
    b_g = addr[5];
    b_b = addr[6];
    b_a = addr[7];
  );

  r = a_r + (b_r - a_r) * t;
  g = a_g + (b_g - a_g) * t;
  b = a_b + (b_b - a_b) * t;
  a = a_a + (b_a - a_a) * t;

  factor = runtime_color_state_factor_private(state);
  r = min(1, max(0, r * factor));
  g = min(1, max(0, g * factor));
  b = min(1, max(0, b * factor));

  gfx_set(r * runtime_dim, g * runtime_dim, b * runtime_dim, a);
);

function runtime_color_apply2(id, slot_a, slot_b, t, state)
  local(palette_row_a, record_row_a, addr_a,
        palette_row_b, record_row_b, addr_b,
        a_r, a_g, a_b, a_a, e_r, e_g, e_b, e_a,
        factor, r, g, b, a)
(
  runtime_color_seed_private();

  palette_row_a = floor(slot_a / 11);
  record_row_a = slot_a - palette_row_a * 11;
  addr_a = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88 + record_row_a * 8;

  addr_a[0] == -1 && addr_a[1] == -1 && addr_a[2] == -1 && addr_a[3] == -1 &&
  addr_a[4] == -1 && addr_a[5] == -1 && addr_a[6] == -1 && addr_a[7] == -1 ? (
    a_r = runtime_color_default_private(palette_row_a, 0);
    a_g = runtime_color_default_private(palette_row_a, 1);
    a_b = runtime_color_default_private(palette_row_a, 2);
    a_a = runtime_color_default_private(palette_row_a, 3);
  ) : (
    a_r = addr_a[0];
    a_g = addr_a[1];
    a_b = addr_a[2];
    a_a = addr_a[3];
  );

  palette_row_b = floor(slot_b / 11);
  record_row_b = slot_b - palette_row_b * 11;
  addr_b = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88 + record_row_b * 8;

  addr_b[0] == -1 && addr_b[1] == -1 && addr_b[2] == -1 && addr_b[3] == -1 &&
  addr_b[4] == -1 && addr_b[5] == -1 && addr_b[6] == -1 && addr_b[7] == -1 ? (
    e_r = runtime_color_default_private(palette_row_b, 0);
    e_g = runtime_color_default_private(palette_row_b, 1);
    e_b = runtime_color_default_private(palette_row_b, 2);
    e_a = runtime_color_default_private(palette_row_b, 3);
  ) : (
    e_r = addr_b[0];
    e_g = addr_b[1];
    e_b = addr_b[2];
    e_a = addr_b[3];
  );

  r = a_r + (e_r - a_r) * t;
  g = a_g + (e_g - a_g) * t;
  b = a_b + (e_b - a_b) * t;
  a = a_a + (e_a - a_a) * t;

  factor = runtime_color_state_factor_private(state);
  r = min(1, max(0, r * factor));
  g = min(1, max(0, g * factor));
  b = min(1, max(0, b * factor));

  gfx_set(r * runtime_dim, g * runtime_dim, b * runtime_dim, a);
);

function runtime_color_literal(a_r, a_g, a_b, a_a, b_r, b_g, b_b, b_a, t, state)
  local(factor, r, g, b, a)
(
  r = a_r + (b_r - a_r) * t;
  g = a_g + (b_g - a_g) * t;
  b = a_b + (b_b - a_b) * t;
  a = a_a + (b_a - a_a) * t;

  factor = runtime_color_state_factor_private(state);
  r = min(1, max(0, r * factor));
  g = min(1, max(0, g * factor));
  b = min(1, max(0, b * factor));

  gfx_set(r * runtime_dim, g * runtime_dim, b * runtime_dim, a);
);

function runtime_set_drag_throw(px)
  local(p)
(
  p = px;
  (p * 0 == 0 && p > 0) ? (
    runtime_drag_throw = p;
    runtime_drag_throw;
  ) : (
    0;
  );
);

function runtime_skirt_draw_literal(kind, x, y, w, h, led_shape, show, width, gap, corner, opacity_a, opacity_b, light_a_r, light_a_g, light_a_b, light_a_a, light_b_r, light_b_g, light_b_b, light_b_a, dark_a_r, dark_a_g, dark_a_b, dark_a_a, dark_b_r, dark_b_g, dark_b_b, dark_b_a)
  local(cx, cy, hw, hh, r, d, qx, qy, inner, outer, t, angle, mix, px, py, x0, x1, y0, y1, lr, lg, lb, la, dr, dg, db, da, circular,
        ie, oe, cov, bx, by, bw, bh, nx, ny, nl, aa, ab, ca)
(
  show && width > 0 && w > 0 && h > 0 && (kind == 1 || kind == 2 || kind == 3 || kind == 5 || kind == 6 || kind == 7) ? (
    bx = floor(runtime_x(x)); by = floor(runtime_y(y));
    bw = floor(runtime_x(x + w)) - bx; bh = floor(runtime_y(y + h)) - by;
    cx = bx + bw / 2; cy = by + bh / 2;
    hw = bw / 2; hh = bh / 2;
    circular = kind == 3 || (kind == 7 && led_shape == 0);
    circular ? (hw = min(hw, hh); hh = hw;);
    kind == 1 ? (hw -= runtime_s(gap); hh -= runtime_s(gap););
    r = circular ? hw : (kind == 1 ? min(max(0, runtime_s(corner)), max(0, min(hw, hh))) : (kind == 2 || kind == 5 ? min(max(0, floor(runtime_s(corner))), floor(min(bw, bh) / 2)) : 0));
    inner = kind == 1 ? -runtime_s(width) : runtime_s(gap);
    outer = kind == 1 ? 0 : runtime_s(gap + width);
    ie = inner - 0.5; oe = outer + 0.5;
    (hw + outer > 0 && hh + outer > 0 && outer > inner) ? (
      x0 = max(0, floor(cx - hw - max(0, oe)));
      y0 = max(0, floor(cy - hh - max(0, oe)));
      x1 = min(gfx_w, ceil(cx + hw + max(0, oe)));
      y1 = min(gfx_h, ceil(cy + hh + max(0, oe)));
      py = y0;
      loop(max(0, y1 - y0),
        circular = 0;
        loop(2,
          qx = abs(py + 0.5 - cy);
          qy = max(0, r + oe);
          lr = -1;
          (qy > 0 && qx <= hh - r && hh + oe > 0) ? lr = hw + oe;
          (qy > 0 && qx > hh - r && qx <= hh + oe) ?
            lr = hw - r + sqrt(max(0, qy^2 - (qx - (hh - r))^2));
          (qy <= 0 && qx <= hh + oe && hw + oe >= 0) ? lr = hw + oe;
          t = max(0, r + ie);
          lg = -1;
          (t > 0 && qx <= hh - r && hh + ie > 0) ? lg = hw + ie;
          (t > 0 && qx > hh - r && qx <= hh + ie) ?
            lg = hw - r + sqrt(max(0, t^2 - (qx - (hh - r))^2));
          (t <= 0 && qx <= hh + ie && hw + ie >= 0) ? lg = hw + ie;
          lr >= 0 ? (
            circular == 0 ? (
              px = max(x0, floor(cx - lr - 0.5));
              y1 = min(x1, ceil(cx - lg - 0.5) + 1);
              y1 = min(y1, floor(cx) + 1);
            ) : (
              px = max(x0, floor(cx + lg - 0.5));
              px = max(px, floor(cx) + 1);
              y1 = min(x1, ceil(cx + lr - 0.5) + 1);
            );
            loop(max(0, y1 - px),
              qx = abs(px + 0.5 - cx) - hw + r;
              qy = abs(py + 0.5 - cy) - hh + r;
              d = min(max(qx, qy), 0) + sqrt(max(qx, 0)^2 + max(qy, 0)^2) - r;
              cov = min(outer, d + 0.5) - max(inner, d - 0.5);
              cov > 0 ? (
                d = min(outer, max(inner, d));
                t = kind == 1 ? (outer - d) / (outer - inner) : (d - inner) / (outer - inner);
                (qx > 0 || qy > 0) ? (
                  nx = max(qx, 0); ny = max(qy, 0);
                ) : (
                  qx > qy ? (nx = 1; ny = 0;) : (qy > qx ? (nx = 0; ny = 1;) : (nx = 1; ny = 1;));
                );
                nx *= sign(px + 0.5 - cx); ny *= sign(py + 0.5 - cy);
                nl = sqrt(nx * nx + ny * ny);
                mix = nl > 0 ? (1 - (nx + ny) / (sqrt(2) * nl)) * 0.5 : 0.5;
                aa = light_a_a * opacity_a; ab = light_b_a * opacity_b;
                la = aa + (ab - aa) * t;
                la > 0 ? (
                  lr = (light_a_r * aa + (light_b_r * ab - light_a_r * aa) * t) / la;
