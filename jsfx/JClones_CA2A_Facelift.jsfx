function edit_has_digit_private(srcstr)
  local(n, i, c, r)
(
  n = strlen(srcstr);
  i = 0;
  r = 0;
  while (i < n) (
    c = str_getchar(srcstr, i);
    (c >= 48 && c <= 57) ? r = 1;
    i += 1;
  );
  r;
);
function edit_parse_private(srcstr)
  local(n, i, c, sign, ip, fp, fd, dot)
(
  n = strlen(srcstr);
  i = 0;
  sign = 1;
  ip = 0;
  fp = 0;
  fd = 1;
  dot = 0;
  while (i < n) (
    c = str_getchar(srcstr, i);
    (c == 45 && i == 0) ? sign = -1 :
    c == 46 ? dot = 1 :
    (c >= 48 && c <= 57) ? (
      dot ? (fd *= 10; fp += (c - 48) / fd;) : (ip = ip * 10 + (c - 48););
    );
    i += 1;
  );
  sign * (ip + fp);
);
