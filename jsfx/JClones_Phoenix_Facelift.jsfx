function runtime_knob_draw_literal(x, y, w, h, ring_px, pointer_px, pointer_len, value_px, frac, hover, str, ring_r, ring_g, ring_b, ring_a, hover_r, hover_g, hover_b, hover_a, pointer_r, pointer_g, pointer_b, pointer_a, inner_inset, inner_ring_px, show_inner_ring, show_inner_fill, show_outer_fill, negative_r, negative_g, negative_b, negative_a, positive_r, positive_g, positive_b, positive_a, label_text_r, label_text_g, label_text_b, label_text_a)
  local(tmp, px, py, pw, ph, pd, cx, cy, ro, rt, r_outer, inset_px, inner_rt,
        r_inner, r_inner_in, fill_cx, fill_cy, pl, hw, f, ang, ux, uy, nx, ny, r, n, t,
        row_start, row_end, row_count, row_i, row_y, sy, ho0, ho1, ho2, ho3,
        hi0, hi1, hi2, hi3, homax, homin, himax, ba, px_x, px_e, s0, s1, s2,
        s3, cov, tw, th, rr, rg, rb, ra, start_x, start_y, min_x, max_x, min_y, max_y,
        sample_x, sample_y, sample_i, sample_j, proj_u, proj_v, half_u, half_v,
        tr, tg, tb, ta, sx, m, dot, r_end, eu)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0) ? (
    pd = min(pw, ph);
    cx = px + pw * 0.5;
    cy = py + ph * 0.5;
    fill_cx = floor(cx + 0.5) + 0.5;
    fill_cy = floor(cy + 0.5) + 0.5;
    ro = pd * 0.5;
    rt = floor(runtime_s(ring_px));
    r_outer = ro - rt;
    inset_px = floor(runtime_s(inner_inset));
    inner_rt = floor(runtime_s(inner_ring_px));
    r_inner = r_outer - inset_px;
    r_inner_in = r_inner - inner_rt;
    pl = floor(runtime_s(pointer_len));
    hw = floor(runtime_s(pointer_px)) * 0.5;
    f = min(max(frac, 0), 1);
    tmp = RUNTIME_ARENA_BASE + RUNTIME_TEMP_OFF;
    rr = hover ? hover_r : ring_r;
    rg = hover ? hover_g : ring_g;
    rb = hover ? hover_b : ring_b;
    ra = hover ? hover_a : ring_a;

    (rt > 0 && r_outer >= 0) ? (
      row_start = floor(fill_cy - ro - 1);
      row_count = ceil(fill_cy + ro + 1) - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        sy = row_y + 0.5 - fill_cy;
        ho0 = sqrt(max(0, (ro + 0.5) * (ro + 0.5) - sy * sy));
        hi0 = max(0, r_outer - 0.5);
        hi0 = sqrt(max(0, hi0 * hi0 - sy * sy));
        ho1 = floor(fill_cx - ho0); hi1 = ceil(fill_cx - hi0);
        n = 0;
        loop(2,
          sx = n == 0 ? ho1 : max(hi1, floor(fill_cx + hi0));
          loop(max(0, (n == 0 ? hi1 : ceil(fill_cx + ho0)) - sx),
            r = sqrt((sx + 0.5 - fill_cx) * (sx + 0.5 - fill_cx) + sy * sy);
            cov = min(ro, r + 0.5) - max(r_outer, r - 0.5);
            cov > 0 ? (
              t = (min(ro, max(r_outer, r)) - r_outer) / rt;
              runtime_color_literal(rr, rg, rb, ra, hover ? tmp[4] : tmp[0],
                                    hover ? tmp[5] : tmp[1],
                                    hover ? tmp[6] : tmp[2],
                                    hover ? tmp[7] : tmp[3], t, RUNTIME_STATE_IDLE);
              gfx_a *= min(1, cov);
              gfx_rect(sx, row_y, 1, 1);
            );
            sx += 1;
          );
          n += 1;
        );
        row_i += 1;
      );
    );

    (show_outer_fill != 0 && r_inner >= 0 && r_outer > r_inner && r_outer > 0) ? (
      row_start = floor(fill_cy - r_outer);
      row_end = ceil(fill_cy + r_outer);
      row_count = row_end - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        t = row_count > 1 ? row_i / (row_count - 1) : 0;
        runtime_color_literal(tmp[24], tmp[25], tmp[26], tmp[27],
                              tmp[28], tmp[29], tmp[30], tmp[31],
                              t, RUNTIME_STATE_IDLE);
        sy = row_y + 0.125 - fill_cy;
        ho0 = abs(sy) < r_outer ? sqrt(r_outer * r_outer - sy * sy) : 0;
        hi0 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        sy = row_y + 0.375 - fill_cy;
        ho1 = abs(sy) < r_outer ? sqrt(r_outer * r_outer - sy * sy) : 0;
        hi1 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        sy = row_y + 0.625 - fill_cy;
        ho2 = abs(sy) < r_outer ? sqrt(r_outer * r_outer - sy * sy) : 0;
        hi2 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        sy = row_y + 0.875 - fill_cy;
        ho3 = abs(sy) < r_outer ? sqrt(r_outer * r_outer - sy * sy) : 0;
        hi3 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        homax = max(max(ho0, ho1), max(ho2, ho3));
        homin = min(min(ho0, ho1), min(ho2, ho3));
        himax = max(max(hi0, hi1), max(hi2, hi3));
        homax > 0 ? (
          ba = gfx_a;
          px_x = floor(fill_cx - homax);
          px_e = ceil(fill_cx + homax);
          s0 = ceil(fill_cx - homin);
          s1 = floor(fill_cx - himax);
          s2 = ceil(fill_cx + himax);
          s3 = floor(fill_cx + homin);
          while (px_x < px_e) (
            px_x >= s0 && px_x < s1 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s1 - px_x, 1);
              px_x = s1;
            ) : px_x >= s2 && px_x < s3 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s3 - px_x, 1);
              px_x = s3;
            ) : (
              cov = 0.25 * (
                max(0, min(px_x + 1, fill_cx - hi0) - max(px_x, fill_cx - ho0)) + max(0, min(px_x + 1, fill_cx + ho0) - max(px_x, fill_cx + hi0)) +
                max(0, min(px_x + 1, fill_cx - hi1) - max(px_x, fill_cx - ho1)) + max(0, min(px_x + 1, fill_cx + ho1) - max(px_x, fill_cx + hi1)) +
                max(0, min(px_x + 1, fill_cx - hi2) - max(px_x, fill_cx - ho2)) + max(0, min(px_x + 1, fill_cx + ho2) - max(px_x, fill_cx + hi2)) +
                max(0, min(px_x + 1, fill_cx - hi3) - max(px_x, fill_cx - ho3)) + max(0, min(px_x + 1, fill_cx + ho3) - max(px_x, fill_cx + hi3)));
              cov > 0 ? (
                gfx_a = ba * min(cov, 1);
                gfx_rect(px_x, row_y, 1, 1);
              );
              px_x += 1;
            );
          );
          gfx_a = ba;
        );
        row_i += 1;
      );
    );

    (show_inner_ring != 0 && inner_rt > 0 && r_inner_in >= 0) ? (
      row_start = floor(fill_cy - r_inner - 1);
      row_count = ceil(fill_cy + r_inner + 1) - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        sy = row_y + 0.5 - fill_cy;
        ho0 = sqrt(max(0, (r_inner + 0.5) * (r_inner + 0.5) - sy * sy));
        hi0 = max(0, r_inner_in - 0.5);
        hi0 = sqrt(max(0, hi0 * hi0 - sy * sy));
        ho1 = floor(fill_cx - ho0); hi1 = ceil(fill_cx - hi0);
        n = 0;
        loop(2,
          sx = n == 0 ? ho1 : max(hi1, floor(fill_cx + hi0));
          loop(max(0, (n == 0 ? hi1 : ceil(fill_cx + ho0)) - sx),
            r = sqrt((sx + 0.5 - fill_cx) * (sx + 0.5 - fill_cx) + sy * sy);
            cov = min(r_inner, r + 0.5) - max(r_inner_in, r - 0.5);
            cov > 0 ? (
              t = (min(r_inner, max(r_inner_in, r)) - r_inner_in) / inner_rt;
              runtime_color_literal(tmp[8], tmp[9], tmp[10], tmp[11],
                                    tmp[12], tmp[13], tmp[14], tmp[15],
                                    t, RUNTIME_STATE_IDLE);
              gfx_a *= min(1, cov);
              gfx_rect(sx, row_y, 1, 1);
            );
            sx += 1;
          );
          n += 1;
        );
        row_i += 1;
      );
    );

    (show_inner_fill != 0 && r_inner_in > 0) ? (
      row_start = floor(fill_cy - r_inner_in);
      row_end = ceil(fill_cy + r_inner_in);
      row_count = row_end - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        t = row_count > 1 ? row_i / (row_count - 1) : 0;
        runtime_color_literal(tmp[16], tmp[17], tmp[18], tmp[19],
                              tmp[20], tmp[21], tmp[22], tmp[23],
                              t, RUNTIME_STATE_IDLE);
        sy = row_y + 0.125 - fill_cy;
        ho0 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi0 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        sy = row_y + 0.375 - fill_cy;
        ho1 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi1 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        sy = row_y + 0.625 - fill_cy;
        ho2 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi2 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        sy = row_y + 0.875 - fill_cy;
        ho3 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi3 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        homax = max(max(ho0, ho1), max(ho2, ho3));
        homin = min(min(ho0, ho1), min(ho2, ho3));
        himax = max(max(hi0, hi1), max(hi2, hi3));
        homax > 0 ? (
          ba = gfx_a;
          px_x = floor(fill_cx - homax);
          px_e = ceil(fill_cx + homax);
          s0 = ceil(fill_cx - homin);
          s1 = floor(fill_cx - himax);
          s2 = ceil(fill_cx + himax);
          s3 = floor(fill_cx + homin);
          while (px_x < px_e) (
            px_x >= s0 && px_x < s1 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s1 - px_x, 1);
              px_x = s1;
            ) : px_x >= s2 && px_x < s3 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s3 - px_x, 1);
              px_x = s3;
            ) : (
              cov = 0.25 * (
                max(0, min(px_x + 1, fill_cx - hi0) - max(px_x, fill_cx - ho0)) + max(0, min(px_x + 1, fill_cx + ho0) - max(px_x, fill_cx + hi0)) +
                max(0, min(px_x + 1, fill_cx - hi1) - max(px_x, fill_cx - ho1)) + max(0, min(px_x + 1, fill_cx + ho1) - max(px_x, fill_cx + hi1)) +
                max(0, min(px_x + 1, fill_cx - hi2) - max(px_x, fill_cx - ho2)) + max(0, min(px_x + 1, fill_cx + ho2) - max(px_x, fill_cx + hi2)) +
                max(0, min(px_x + 1, fill_cx - hi3) - max(px_x, fill_cx - ho3)) + max(0, min(px_x + 1, fill_cx + ho3) - max(px_x, fill_cx + hi3)));
              cov > 0 ? (
                gfx_a = ba * min(cov, 1);
                gfx_rect(px_x, row_y, 1, 1);
              );
              px_x += 1;
            );
          );
          gfx_a = ba;
        );
        row_i += 1;
      );
    );

    dot = tmp[32] != 0;
    r_end = dot ? ro - floor(runtime_s(tmp[33])) : r_outer;
    (pl > 0 && hw >= 0.5 && (dot || r_outer - pl >= 0)) ? (
      runtime_color_literal(pointer_r, pointer_g, pointer_b, pointer_a,
                            pointer_r, pointer_g, pointer_b, pointer_a,
                            0, RUNTIME_STATE_IDLE);
      ang = f * 2 * $pi;
      ux = sin(ang);
      uy = -cos(ang);
      nx = uy;
      ny = -ux;
      start_x = cx + ux * (r_end - pl);
      start_y = cy + uy * (r_end - pl);
      min_x = min(start_x, cx + ux * r_end) - abs(nx) * hw;
      max_x = max(start_x, cx + ux * r_end) + abs(nx) * hw;
      min_y = min(start_y, cy + uy * r_end) - abs(ny) * hw;
      max_y = max(start_y, cy + uy * r_end) + abs(ny) * hw;
      half_u = (abs(ux) + abs(uy)) * 0.5;
      half_v = (abs(nx) + abs(ny)) * 0.5;
      row_start = floor(min_y);
      row_end = ceil(max_y);
      row_count = row_end - row_start;
      row_i = 0;
      ba = gfx_a;
      loop(row_count,
        row_y = row_start + row_i;
        px_x = floor(min_x);
        px_e = ceil(max_x);
        while (px_x < px_e) (
          sample_x = px_x + 0.5;
          sample_y = row_y + 0.5;
          proj_u = (sample_x - start_x) * ux + (sample_y - start_y) * uy;
          proj_v = (sample_x - start_x) * nx + (sample_y - start_y) * ny;
          (dot == 0 && proj_u - half_u >= 0 && proj_u + half_u <= pl &&
           proj_v - half_v >= -hw && proj_v + half_v <= hw) ? (
            cov = 1;
          ) : (
            (px_x + 1 <= min_x || px_x >= max_x || row_y + 1 <= min_y || row_y >= max_y ||
             proj_u + half_u <= 0 || proj_u - half_u >= pl ||
             proj_v + half_v <= -hw || proj_v - half_v >= hw) ? (
              cov = 0;
            ) : (
              cov = 0;
              sample_i = 0;
              loop(16,
                sample_j = 0;
                loop(16,
                  sample_x = px_x + (sample_i + 0.5) / 16;
                  sample_y = row_y + (sample_j + 0.5) / 16;
                  proj_u = (sample_x - start_x) * ux + (sample_y - start_y) * uy;
                  proj_v = (sample_x - start_x) * nx + (sample_y - start_y) * ny;
                  eu = (proj_u - pl * 0.5) / (pl * 0.5);
                  (dot ? (eu * eu + (proj_v / hw) * (proj_v / hw) <= 1) :
                   (proj_u >= 0 && proj_u <= pl && abs(proj_v) <= hw)) ? cov += 1;
                  sample_j += 1;
                );
                sample_i += 1;
              );
              cov /= 256;
            );
          );
          cov > 0 ? (
            gfx_a = ba * cov;
            gfx_rect(px_x, row_y, 1, 1);
          );
          px_x += 1;
        );
        row_i += 1;
      );
      gfx_a = ba;
    );

    strlen(str) > 0 ? (
      runtime_text_font_private(runtime_sf(value_px));
      m = runtime_text_ink_private(runtime_sf(value_px));
      gfx_measurestr(str, tw, th);
      gfx_x = floor(cx - tw * 0.5);
      gfx_y = floor(cy - m);
      tr = runtime_text_sign < 0 ? negative_r : (runtime_text_sign > 0 ? positive_r : label_text_r);
      tg = runtime_text_sign < 0 ? negative_g : (runtime_text_sign > 0 ? positive_g : label_text_g);
      tb = runtime_text_sign < 0 ? negative_b : (runtime_text_sign > 0 ? positive_b : label_text_b);
      ta = runtime_text_sign < 0 ? negative_a : (runtime_text_sign > 0 ? positive_a : label_text_a);
      runtime_color_literal(tr, tg, tb, ta, tr, tg, tb, ta, 0, RUNTIME_STATE_IDLE);
      runtime_text_draw_private(str, 0, 0);
    );
  );
  runtime_text_style(0, 0);
  runtime_text_sign = 0;
);

function runtime_label_draw(id, x, y, w, h, slot, font_px, str)
  local(px, py, pw, ph, tw, th)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0 && strlen(str) > 0) ? (
    runtime_text_font_private(runtime_sf(font_px));
    gfx_measurestr(str, tw, th);
    tw = runtime_text_draw_private(str, 1, 1);
    gfx_x = px + floor((pw - tw) * 0.5);
    gfx_y = py + floor((ph - th) * 0.5);
    runtime_color_apply(id, slot, 0, RUNTIME_STATE_IDLE);
    runtime_text_draw_private(str, 0, 1);
  );
  runtime_text_style(0, 0);
);

function runtime_label_draw_literal(x, y, w, h, font_px, str, text_r, text_g, text_b, text_a)
  local(px, py, pw, ph, tw, th)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0 && strlen(str) > 0) ? (
    runtime_text_font_private(runtime_sf(font_px));
    gfx_measurestr(str, tw, th);
    tw = runtime_text_draw_private(str, 1, 1);
    gfx_x = px + floor((pw - tw) * 0.5);
    gfx_y = py + floor((ph - th) * 0.5);
    runtime_color_literal(text_r, text_g, text_b, text_a, text_r, text_g, text_b, text_a, 0,
                         RUNTIME_STATE_IDLE);
    runtime_text_draw_private(str, 0, 1);
  );
  runtime_text_style(0, 0);
);

function runtime_numbox_addr_private(widget_id)
(
  RUNTIME_ARENA_BASE + RUNTIME_WIDGET_OFF + (widget_id - 1) * 8;
);

function runtime_numbox_decimals_private(vstep)
  local(d, i, s)
(
  vstep == 0 ? 2 : (
    d = 6;
    i = 6;
    loop(7,
      s = abs(vstep) * pow(10, i);
      abs(s - floor(s + 0.5)) <= 0.000000001 ? d = i;
      i -= 1;
    );
    d;
  );
);

function runtime_numbox_init(widget_id, value, enabled, flags, vmin, vmax, vstep)
  local(a)
(
  a = runtime_numbox_addr_private(widget_id);
  a[3] = vmin;
  a[4] = vmax;
  a[5] = vstep;
  a[6] = runtime_numbox_decimals_private(vstep);
  a[0] = min(max(value, vmin), vmax);
  a[1] = enabled != 0 ? 1 : 0;
  a[2] = flags;
  a[7] = -1;
);

function runtime_numbox_get(widget_id)
  local(a)
(
  a = runtime_numbox_addr_private(widget_id);
  a[0];
);

function runtime_numbox_set(widget_id, value)
  local(a)
(
  a = runtime_numbox_addr_private(widget_id);
  a[0] = min(max(value, a[3]), a[4]);
);

function runtime_numbox_format(widget_id, out)
  local(a, d, v)
(
  a = runtime_numbox_addr_private(widget_id);
  d = a[6];
  v = a[0];
  floor(abs(v) * pow(10, d) + 0.5) == 0 ? v = 0;
  runtime_text_sign = v < 0 ? -1 : (v > 0 ? 1 : 0);
  d == 0 ? sprintf(out, "%.0f", v) :
  d == 1 ? sprintf(out, "%.1f", v) :
  d == 2 ? sprintf(out, "%.2f", v) :
  d == 3 ? sprintf(out, "%.3f", v) :
  d == 4 ? sprintf(out, "%.4f", v) :
  d == 5 ? sprintf(out, "%.5f", v) :
           sprintf(out, "%.6f", v);
  d;
);

function runtime_numbox_format_text(widget_id, out, decimals, flags, unit, below)
  local(a, d, v, m, r, fmt)
(
  a = runtime_numbox_addr_private(widget_id);
  v = a[0];
  d = decimals >= 0 ? decimals : a[6];
  runtime_text_sign = v < 0 ? -1 : (v > 0 ? 1 : 0);
  (v == a[3] && strlen(below) > 0) ? (
    strcpy(out, below);
  ) : (
    m = abs(v);
    ((flags & 2) && m >= 1000) ? (
      r = m >= 1000000 ? floor(m / 100000 + 0.5) : floor(m / 100 + 0.5);
      r = (v < 0 ? -r : r) / 10;
      fmt = (r == floor(r)) ? (((flags & 1) && r > 0) ? "%+.0f" : "%.0f")
                            : (((flags & 1) && r > 0) ? "%+.1f" : "%.1f");
      sprintf(out, fmt, r);
      strcat(out, m >= 1000000 ? "M" : "k");
    ) : (
      floor(m * pow(10, d) + 0.5) == 0 ? (v = 0; runtime_text_sign = 0;);
      fmt = ((flags & 1) && v > 0) ? (
        d == 0 ? "%+.0f" : (d == 1 ? "%+.1f" : (d == 2 ? "%+.2f" : (d == 3 ? "%+.3f" :
        (d == 4 ? "%+.4f" : (d == 5 ? "%+.5f" : "%+.6f")))))
      ) : (
        d == 0 ? "%.0f" : (d == 1 ? "%.1f" : (d == 2 ? "%.2f" : (d == 3 ? "%.3f" :
        (d == 4 ? "%.4f" : (d == 5 ? "%.5f" : "%.6f")))))
      );
      sprintf(out, fmt, v);
    );
    strlen(unit) > 0 ? (
      strcmp(unit, "%") == 0 ? strcat(out, unit) : (strcat(out, " "); strcat(out, unit););
    );
  );
  d;
);

function runtime_numbox_mouse(widget_id, owner_id, my, anchor_y, anchor_v)
  local(a, v0, v1)
(
  a = runtime_numbox_addr_private(widget_id);
  v0 = a[0];
  v1 = v0;
  (a[1] != 0 && owner_id == widget_id) ? (
    v1 = anchor_v + (anchor_y - my) / runtime_s(runtime_drag_throw) * (a[4] - a[3]);
    v1 = min(max(v1, a[3]), a[4]);
  );
  a[0] = v1;
  v1 != v0;
);

function runtime_numbox_reset(widget_id, owner_id, mx, my, x, y, w, h, trigger)
  local(a, v0)
(
  a = runtime_numbox_addr_private(widget_id);
  v0 = a[0];
  (trigger == 1 && owner_id == 0 && a[1] != 0 &&
   runtime_hit(mx, my, x, y, w, h)) ? (
    a[0] = a[3];
  );
  a[0] != v0;
);

function runtime_numbox_reset_to(widget_id, owner_id, mx, my, x, y, w, h, trigger, value)
  local(a, v0)
(
  a = runtime_numbox_addr_private(widget_id);
  v0 = a[0];
  (trigger == 1 && owner_id == 0 && a[1] != 0 &&
   runtime_hit(mx, my, x, y, w, h)) ? (
    a[0] = min(max(value, a[3]), a[4]);
  );
  a[0] != v0;
);

function runtime_numbox_draw(id, x, y, w, h, radius, caret_px, value_px, editing, str)
  local(px, py, pw, ph, pr, cx, cy, sx, tw, th, cw, ch, s_fill, s_text, m)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  pr = floor(runtime_s(radius));
  (pw > 0 && ph > 0) ? (
    cx = px + pw * 0.5;
    cy = py + ph * 0.5;
    sx = floor(cx);
    tw = 0;
    s_fill = editing ? RUNTIME_SLOT_NUMBOX_EDIT_FILL : RUNTIME_SLOT_NUMBOX_FILL;
    s_text = editing ? RUNTIME_SLOT_NUMBOX_EDIT_TEXT :
             (runtime_text_sign < 0 ? RUNTIME_SLOT_NUMBOX_NEGATIVE :
             (runtime_text_sign > 0 ? RUNTIME_SLOT_NUMBOX_POSITIVE : RUNTIME_SLOT_NUMBOX_TEXT));
    runtime_color_apply(id, s_fill, 0, RUNTIME_STATE_IDLE);
    runtime_rr_fill(px, py, pw, ph, pr);
    m = 0;
    strlen(str) > 0 ? (
      runtime_text_font_private(runtime_sf(value_px));
      m = runtime_text_ink_private(runtime_sf(value_px));
      gfx_measurestr(str, tw, th);
      sx = floor(cx - tw * 0.5);
      gfx_x = sx;
      gfx_y = floor(cy - m);
      runtime_color_apply(id, s_text, 0, RUNTIME_STATE_IDLE);
      runtime_text_draw_private(str, 0, 0);
    );
    editing ? (
      cw = floor(runtime_s(caret_px));
      ch = runtime_sf(value_px);
      (cw > 0 && ch > 0) ? (
        runtime_color_apply(id, RUNTIME_SLOT_NUMBOX_ACCENT, 0, RUNTIME_STATE_IDLE);
        gfx_rect(sx + tw, floor(floor(cy - m) + m - ch * 0.5), cw, ch);
      );
    );
  );
  runtime_text_style(0, 0);
  runtime_text_sign = 0;
);

function runtime_numbox_draw_literal(x, y, w, h, radius, caret_px, value_px, editing, str, fill_r, fill_g, fill_b, fill_a, edit_fill_r, edit_fill_g, edit_fill_b, edit_fill_a, text_r, text_g, text_b, text_a, edit_text_r, edit_text_g, edit_text_b, edit_text_a, accent_r, accent_g, accent_b, accent_a, negative_r, negative_g, negative_b, negative_a, positive_r, positive_g, positive_b, positive_a)
  local(px, py, pw, ph, pr, cx, cy, sx, tw, th, cw, ch, fr, fg, fb, fa, tr, tg, tb, ta, m)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  pr = floor(runtime_s(radius));
  (pw > 0 && ph > 0) ? (
    cx = px + pw * 0.5;
    cy = py + ph * 0.5;
    sx = floor(cx);
    tw = 0;
    fr = editing ? edit_fill_r : fill_r;
    fg = editing ? edit_fill_g : fill_g;
    fb = editing ? edit_fill_b : fill_b;
    fa = editing ? edit_fill_a : fill_a;
    tr = editing ? edit_text_r : (runtime_text_sign < 0 ? negative_r : (runtime_text_sign > 0 ? positive_r : text_r));
    tg = editing ? edit_text_g : (runtime_text_sign < 0 ? negative_g : (runtime_text_sign > 0 ? positive_g : text_g));
    tb = editing ? edit_text_b : (runtime_text_sign < 0 ? negative_b : (runtime_text_sign > 0 ? positive_b : text_b));
    ta = editing ? edit_text_a : (runtime_text_sign < 0 ? negative_a : (runtime_text_sign > 0 ? positive_a : text_a));
    runtime_color_literal(fr, fg, fb, fa, fr, fg, fb, fa, 0, RUNTIME_STATE_IDLE);
    runtime_rr_fill(px, py, pw, ph, pr);
    m = 0;
    strlen(str) > 0 ? (
      runtime_text_font_private(runtime_sf(value_px));
      m = runtime_text_ink_private(runtime_sf(value_px));
      gfx_measurestr(str, tw, th);
      sx = floor(cx - tw * 0.5);
      gfx_x = sx;
      gfx_y = floor(cy - m);
      runtime_color_literal(tr, tg, tb, ta, tr, tg, tb, ta, 0, RUNTIME_STATE_IDLE);
      runtime_text_draw_private(str, 0, 0);
    );
    editing ? (
      cw = floor(runtime_s(caret_px));
      ch = runtime_sf(value_px);
      (cw > 0 && ch > 0) ? (
        runtime_color_literal(accent_r, accent_g, accent_b, accent_a, accent_r, accent_g, accent_b, accent_a, 0, RUNTIME_STATE_IDLE);
        gfx_rect(sx + tw, floor(floor(cy - m) + m - ch * 0.5), cw, ch);
      );
    );
  );
  runtime_text_style(0, 0);
  runtime_text_sign = 0;
);

function runtime_meter_span_private(id, slot, x, y, w, h, px, py, pw, ph, f0, f1, direction)
  local(e0, e1, rx, ry, rw, rh)
(
  f1 > f0 ? (
    direction == 0 ? (
      e0 = floor(runtime_y(y + h - f0 * h));
      e1 = floor(runtime_y(y + h - f1 * h));
      e0 = min(py + ph, max(py, e0));
      e1 = min(py + ph, max(py, e1));
      rx = px;
      ry = e1;
